<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/paper_stack"
    android:paddingRight="3dp"
    android:paddingBottom="5dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/hills"
            android:tint="#C0814E"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:scaleType="fitXY"
            android:src="@drawable/hills" />


        <!-- 墨丸 V3：一張靜態圖（P5-3、P5-4；P7-1 起是唯一的角色）。預設圖給 launcher 的小工具預覽用，實際畫面由程式換成當天的墨丸 -->
        <ImageView
            android:id="@+id/mowan_still"
            android:layout_width="42dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/mowan_preview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/band"
                android:tint="#C0814E"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:scaleType="fitXY"
                android:src="@drawable/band" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.9"
                    android:orientation="vertical">

                    <!-- 英文月份放在中文月份下一行：橫排時最小尺寸放不下（P7-1） -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/month"
                            android:text="十月"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:maxLines="1"
                            android:letterSpacing="0.1"
                            android:textColor="@color/ink"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/month_en"
                            android:text="OCTOBER 2026"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:letterSpacing="0.2"
                            android:textColor="@color/ink_soft"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/day"
                        android:text="21"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="72sp"
                        android:autoSizeMinTextSize="32sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/ink"
                        android:textSize="72sp" />
                    <TextView
                        android:id="@+id/weekday"
                        android:text="星期三"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:maxLines="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="5dp"
                        android:letterSpacing="0.1"
                        android:textColor="@color/ink"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="46dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:maxLines="1"
                        android:letterSpacing="0.1"
                        android:visibility="gone"
                        android:textColor="@color/red"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/phrase"
                        android:text="宜 出行・祭祀"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:letterSpacing="0.15"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />
                    <ImageView
                        android:id="@+id/rule"
                        android:tint="#C0814E"
                        android:layout_width="20dp"
                        android:layout_height="1dp"
                        android:layout_gravity="left"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="3dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/rule" />
                    <TextView
                        android:id="@+id/lunar"
                        android:text="農曆九月十一・丙午年"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:letterSpacing="0.05"
                        android:textColor="@color/ink_mid"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/ji"
                        android:text="忌 動土・安葬"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="1dp"
                        android:letterSpacing="0.05"
                        android:textColor="@color/ink_mid"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        <!-- 這個版面放不下，但 id 要在，程式才不用分好幾套 -->
        <TextView
            android:id="@+id/sun"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
