<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="12dp"
        android:paddingRight="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prev"
                android:textColor="@color/ink_soft" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/next"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next"
                android:textColor="@color/ink_soft" />
        </LinearLayout>

        <!-- 「回到最上面那頁」自己一列（P7-7 導覽列候選 A）：放在前一天／後一天中間時，大字體或窄螢幕會被擠成直排（D-54）。
             看最上面那頁時 GONE（不佔高度） -->
        <Button
            android:id="@+id/today"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/today"
            android:textColor="@color/red"
            android:visibility="gone" />

        <!-- 城市入口（P7-2 方案 A，D-53）：日曆上方靠右，「⌖ 臺北市 ⌄」。天氣、溫度、日出日落在日曆裡。
             整塊可以點（至少 48×48dp），只有系統的淡漣漪，不加卡片、底色或外框；圖示在程式裡跟著字的大小設定。
             右內距 8dp：下拉符號在程式裡往左貼齊城市名，留下的 4dp 加上這 8dp，跟參考圖一樣是 12dp -->
        <TextView
            android:id="@+id/city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:letterSpacing="0.1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingLeft="12dp"
            android:paddingRight="8dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <!-- 可以用手指撕的那一頁 -->
        <com.patty60723.tearoff.TearPageView
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="2dp" />

        <Button
            android:id="@+id/tear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/tear_button"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- 墨丸 V3（P7-1 起是唯一的角色）。點一下是天氣彩蛋（P7-2，D-48）：可點範圍就是這 96×128dp；
                 不加漣漪（沒有背景）、不震動 -->
            <com.patty60723.tearoff.mowan.MowanView
                android:id="@+id/story_mowan"
                android:layout_width="96dp"
                android:layout_height="128dp"
                android:clickable="true"
                android:focusable="true"
                android:hapticFeedbackEnabled="false" />

            <LinearLayout
                android:id="@+id/story_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/story_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:textColor="@color/red"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/story_text"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="serif"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <!-- 包袱（第 14 頁取得後）：背上／卸下的小連結 -->
                <TextView
                    android:id="@+id/story_bundle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:fontFamily="serif"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.1"
                    android:minHeight="48dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/yi"
            android:textColor="@color/red" />

        <TextView
            android:id="@+id/yi_all"
            style="@style/SectionBody" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/ji" />

        <TextView
            android:id="@+id/ji_all"
            style="@style/SectionBody" />

        <TextView
            android:id="@+id/details"
            style="@style/SectionBody"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink_soft" />

        <Button
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/ink"
            android:text="@string/pin"
            android:textColor="@color/paper" />

        <TextView
            style="@style/SectionBody"
            android:layout_marginTop="8dp"
            android:text="@string/how_to"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionBody"
            android:layout_marginTop="4dp"
            android:text="@string/weather_credit"
            android:textColor="@color/ink_soft"
            android:textSize="11sp" />

        <!-- 只有測試版看得到 -->
        <Button
            android:id="@+id/debug"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="除錯"
            android:textColor="@color/ink_soft"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
