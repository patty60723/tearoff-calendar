<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="12dp"
        android:paddingRight="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prev"
                android:textColor="@color/ink_soft" />

            <Button
                android:id="@+id/today"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today"
                android:textColor="@color/red" />

            <Button
                android:id="@+id/next"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next"
                android:textColor="@color/ink_soft" />
        </LinearLayout>

        <!-- 可以用手指撕的那一頁 -->
        <com.patty60723.tearoff.TearPageView
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="2dp" />

        <Button
            android:id="@+id/tear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/tear_button"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <!-- 今天的天氣，點一下火柴人就會演給你看 -->
        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="serif"
            android:letterSpacing="0.1"
            android:padding="8dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <!-- 日出日落用哪個城市算，點一下可以換 -->
        <TextView
            android:id="@+id/city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="serif"
            android:letterSpacing="0.1"
            android:padding="8dp"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.patty60723.tearoff.stickman.StickmanView
                android:id="@+id/story_stickman"
                android:layout_width="96dp"
                android:layout_height="128dp" />

            <!-- 墨丸 V3：除錯選單打開才顯示，整合完成前故事卡還是舊火柴人 -->
            <com.patty60723.tearoff.mowan.MowanView
                android:id="@+id/story_mowan"
                android:layout_width="96dp"
                android:layout_height="128dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/story_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:textColor="@color/red"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/story_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="serif"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/yi"
            android:textColor="@color/red" />

        <TextView
            android:id="@+id/yi_all"
            style="@style/SectionBody" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/ji" />

        <TextView
            android:id="@+id/ji_all"
            style="@style/SectionBody" />

        <TextView
            android:id="@+id/details"
            style="@style/SectionBody"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink_soft" />

        <Button
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/ink"
            android:text="@string/pin"
            android:textColor="@color/paper" />

        <TextView
            style="@style/SectionBody"
            android:layout_marginTop="8dp"
            android:text="@string/how_to"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionBody"
            android:layout_marginTop="4dp"
            android:text="@string/weather_credit"
            android:textColor="@color/ink_soft"
            android:textSize="11sp" />

        <!-- 只有測試版看得到 -->
        <Button
            android:id="@+id/debug"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="除錯"
            android:textColor="@color/ink_soft"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
