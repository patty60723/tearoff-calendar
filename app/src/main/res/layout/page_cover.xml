<?xml version="1.0" encoding="utf-8"?>
<!-- 封面：第一次打開時最上面那張 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/paper_stack"
    android:paddingRight="3dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/hills"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/hills" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/band"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:scaleType="fitXY"
            android:src="@drawable/band" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cover_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.15"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:letterSpacing="0.6"
            android:text="@string/cover_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/rule"
            android:tint="@color/ink_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.2"
            android:text="@string/cover_sub"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4" />
    </LinearLayout>
</FrameLayout>
