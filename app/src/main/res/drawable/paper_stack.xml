<?xml version="1.0" encoding="utf-8"?>
<!-- 底下還有好幾頁沒撕的紙 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="6dp">
        <shape>
            <solid android:color="@color/paper_bottom" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="2dp" android:right="2dp" android:top="3dp">
        <shape>
            <solid android:color="@color/paper_under" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:bottom="6dp" android:right="4dp">
        <shape>
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="@color/paper_edge" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
