<?xml version="1.0" encoding="utf-8"?>
<!-- 一疊還沒撕的紙：最上面一頁，底下露出兩層紙邊 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:right="1dp" android:top="6dp">
        <shape>
            <solid android:color="@color/paper_bottom" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="1dp" android:right="2dp" android:top="3dp">
        <shape>
            <solid android:color="@color/paper_under" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="5dp" android:right="3dp">
        <shape>
            <solid android:color="@color/paper" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
